rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can view recipe images; only the admin can upload
    match /recipe-images/{allPaths=**} {
      allow read;
      allow write: if request.auth != null
                   && request.auth.token.email == 'rlmotyer@gmail.com';
    }
  }
}
